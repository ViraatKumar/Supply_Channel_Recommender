# Copy to local.env and fill in. local.env is gitignored and must never be committed.
# Used by the IntelliJ run configuration; docker-compose reads GEMINI_API_KEY from your shell.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/supply
SPRING_DATASOURCE_USERNAME=supply
SPRING_DATASOURCE_PASSWORD=supply

# Optional. Leave blank and the app still runs — /api/parse-brief reports the parser
# unavailable and the UI falls back to the manual form.
GEMINI_API_KEY=
